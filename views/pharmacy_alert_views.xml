<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alert List View -->
    <record id="view_hospital_pharmacy_alert_list" model="ir.ui.view">
        <field name="name">hospital.pharmacy.alert.list</field>
        <field name="model">hospital.pharmacy.alert</field>
        <field name="arch" type="xml">
            <list string="Inventory Alerts" decoration-danger="status == 'active'" decoration-muted="status == 'resolved'">
                <field name="name"/>
                <field name="alert_type" widget="badge" decoration-warning="alert_type == 'low_stock'" decoration-danger="alert_type == 'expiry'"/>
                <field name="medicine_id"/>
                <field name="batch_id"/>
                <field name="date_created"/>
                <field name="status" widget="badge" decoration-danger="status == 'active'" decoration-success="status == 'resolved'"/>
            </list>
        </field>
    </record>

    <!-- Alert Form View -->
    <record id="view_hospital_pharmacy_alert_form" model="ir.ui.view">
        <field name="name">hospital.pharmacy.alert.form</field>
        <field name="model">hospital.pharmacy.alert</field>
        <field name="arch" type="xml">
            <form string="Inventory Alert">
                <header>
                    <button name="action_resolve" string="Mark Resolved" type="object" class="oe_highlight" invisible="status != 'active'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="alert_type" readonly="1"/>
                            <field name="medicine_id" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_created" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Alert Details" name="details">
                            <field name="message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Alert Search View -->
    <record id="view_hospital_pharmacy_alert_search" model="ir.ui.view">
        <field name="name">hospital.pharmacy.alert.search</field>
        <field name="model">hospital.pharmacy.alert</field>
        <field name="arch" type="xml">
            <search string="Search Inventory Alerts">
                <field name="name"/>
                <field name="medicine_id"/>
                <field name="batch_id"/>
                <filter string="Active" name="active_alerts" domain="[('status', '=', 'active')]"/>
                <filter string="Resolved" name="resolved_alerts" domain="[('status', '=', 'resolved')]"/>
                <filter string="Expiry Alerts" name="expiry_alerts" domain="[('alert_type', '=', 'expiry')]"/>
                <filter string="Low Stock Alerts" name="low_stock_alerts" domain="[('alert_type', '=', 'low_stock')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'alert_type'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Medicine" name="group_by_medicine" context="{'group_by': 'medicine_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Alert Action -->
    <record id="action_hospital_pharmacy_alert" model="ir.actions.act_window">
        <field name="name">Inventory Alerts</field>
        <field name="res_model">hospital.pharmacy.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_pharmacy_alert_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active inventory alerts!
            </p>
            <p>
                The system checks stock levels and batch expiry dates daily and populates alerts here.
            </p>
        </field>
    </record>
</odoo>
