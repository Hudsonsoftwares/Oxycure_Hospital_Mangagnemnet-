<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expired Disposal List View -->
    <record id="view_hospital_expired_disposal_list" model="ir.ui.view">
        <field name="name">hospital.expired.disposal.list</field>
        <field name="model">hospital.expired.disposal</field>
        <field name="arch" type="xml">
            <list string="Expired Disposals">
                <field name="name"/>
                <field name="medicine_id"/>
                <field name="batch_id"/>
                <field name="qty"/>
                <field name="disposed_by_id"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <!-- Expired Disposal Form View -->
    <record id="view_hospital_expired_disposal_form" model="ir.ui.view">
        <field name="name">hospital.expired.disposal.form</field>
        <field name="model">hospital.expired.disposal</field>
        <field name="arch" type="xml">
            <form string="Expired Disposal">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Medicine Info">
                            <field name="medicine_id"/>
                            <field name="batch_id"/>
                        </group>
                        <group string="Disposal Details">
                            <field name="qty"/>
                            <field name="disposed_by_id" readonly="1"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason" placeholder="Explain disposal method/reason (e.g. incineration, supplier return instruction)..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Expired Disposal Action -->
    <record id="action_hospital_expired_disposal" model="ir.actions.act_window">
        <field name="name">Expired Disposals</field>
        <field name="res_model">hospital.expired.disposal</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record an Expired Medicine Disposal!
            </p>
            <p>
                Track when expired medicines are destroyed or discarded. Deducts stock and logs a disposal movement.
            </p>
        </field>
    </record>
</odoo>
