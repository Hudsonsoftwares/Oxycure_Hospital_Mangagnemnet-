<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lab Equipment List View -->
    <record id="view_hospital_lab_equipment_list" model="ir.ui.view">
        <field name="name">hospital.lab.equipment.list</field>
        <field name="model">hospital.lab.equipment</field>
        <field name="arch" type="xml">
            <list string="Laboratory Equipment" decoration-success="status == 'active'" decoration-danger="status == 'inactive'">
                <field name="name"/>
                <field name="test_ids" widget="many2many_tags"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'inactive'"/>
            </list>
        </field>
    </record>

    <!-- Lab Equipment Form View -->
    <record id="view_hospital_lab_equipment_form" model="ir.ui.view">
        <field name="name">hospital.lab.equipment.form</field>
        <field name="model">hospital.lab.equipment</field>
        <field name="arch" type="xml">
            <form string="Laboratory Equipment Info">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Equipment Name (e.g. Centrifuge model 500)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Supported Lab Tests" name="supported_tests">
                            <field name="test_ids" placeholder="Select tests supported by this equipment...">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lab Equipment Search View -->
    <record id="view_hospital_lab_equipment_search" model="ir.ui.view">
        <field name="name">hospital.lab.equipment.search</field>
        <field name="model">hospital.lab.equipment</field>
        <field name="arch" type="xml">
            <search string="Search Lab Equipment">
                <field name="name"/>
                <field name="test_ids"/>
                <separator/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Inactive" name="inactive" domain="[('status', '=', 'inactive')]"/>
            </search>
        </field>
    </record>

    <!-- Lab Equipment Action -->
    <record id="action_hospital_lab_equipment" model="ir.actions.act_window">
        <field name="name">Lab Equipment</field>
        <field name="res_model">hospital.lab.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_lab_equipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first lab equipment!
            </p>
            <p>
                Define equipment items available in your laboratory and link them to the tests they support.
            </p>
        </field>
    </record>

    <!-- Lab Equipment Menu Item -->
    <menuitem id="menu_hospital_lab_equipment"
              name="Lab Equipment"
              parent="menu_hospital_laboratory"
              action="action_hospital_lab_equipment"
              sequence="15"/>
</odoo>
