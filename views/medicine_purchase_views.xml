<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order List View -->
    <record id="view_hospital_medicine_purchase_list" model="ir.ui.view">
        <field name="name">hospital.medicine.purchase.list</field>
        <field name="model">hospital.medicine.purchase</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders" decoration-success="state == 'received'" decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="purchase_date"/>
                <field name="amount_total" sum="Total Purchases"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'received'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Purchase Order Form View -->
    <record id="view_hospital_medicine_purchase_form" model="ir.ui.view">
        <field name="name">hospital.medicine.purchase.form</field>
        <field name="model">hospital.medicine.purchase</field>
        <field name="arch" type="xml">
            <form string="Purchase Order">
                <header>
                    <button name="action_receive" string="Receive Medicines" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_id" readonly="state != 'draft'"/>
                            <field name="purchase_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount_total" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medicines" name="purchase_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="batch_number"/>
                                    <field name="manufacturing_date"/>
                                    <field name="expiry_date"/>
                                    <field name="qty"/>
                                    <field name="purchase_price"/>
                                    <field name="selling_price"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Purchase Order Action -->
    <record id="action_hospital_medicine_purchase" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">hospital.medicine.purchase</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Purchase Order!
            </p>
            <p>
                Purchase Orders help you buy medicines from suppliers and bring them into stock.
            </p>
        </field>
    </record>
</odoo>
