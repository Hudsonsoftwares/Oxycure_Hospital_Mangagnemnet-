<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category List View -->
    <record id="view_hospital_medicine_category_list" model="ir.ui.view">
        <field name="name">hospital.medicine.category.list</field>
        <field name="model">hospital.medicine.category</field>
        <field name="arch" type="xml">
            <list string="Medicine Categories">
                <field name="complete_name"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Category Form View -->
    <record id="view_hospital_medicine_category_form" model="ir.ui.view">
        <field name="name">hospital.medicine.category.form</field>
        <field name="model">hospital.medicine.category</field>
        <field name="arch" type="xml">
            <form string="Medicine Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="complete_name" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Category notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Action -->
    <record id="action_hospital_medicine_category" model="ir.actions.act_window">
        <field name="name">Medicine Categories</field>
        <field name="res_model">hospital.medicine.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first medicine category!
            </p>
            <p>
                Categories help you group medicines (e.g. Antibiotics, Analgesics, etc.).
            </p>
        </field>
    </record>
</odoo>
