<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Doctor Tree View -->
    <record id="view_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hospital.doctor.tree</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Doctors" decoration-success="status == 'available'" decoration-warning="status == 'on_leave'" decoration-muted="status == 'inactive'">
                <field name="doctor_id"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="specialization"/>
                <field name="mobile"/>
                <field name="consultation_fee"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'on_leave'" decoration-muted="status == 'inactive'"/>
            </list>
        </field>
    </record>

    <!-- Doctor Form View -->
    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor Profile">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="doctor_id" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Doctor Name"/>
                        </h2>
                    </div>
                    <notebook>
                        <page string="Personal Info" name="personal_info">
                            <group>
                                <group string="Demographics">
                                    <field name="gender"/>
                                    <field name="dob"/>
                                    <field name="age" readonly="1"/>
                                    <field name="blood_group"/>
                                </group>
                                <group string="Marital Status">
                                    <field name="marital_status"/>
                                </group>
                            </group>
                        </page>
                        <page string="Professional Information" name="professional_info">
                            <group>
                                <group string="Organization">
                                    <field name="department_id" options="{'no_create': True}"/>
                                    <field name="joining_date"/>
                                </group>
                                <group string="Credentials &amp; Fees">
                                    <field name="qualification"/>
                                    <field name="specialization"/>
                                    <field name="medical_registration_no"/>
                                    <field name="experience"/>
                                    <field name="consultation_fee"/>
                                    <field name="user_id" options="{'no_create': True}"/>
                                    <field name="signature" widget="image" options="{'size': [0, 90]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contact Details" name="contact_details">
                            <group>
                                <group string="Communications">
                                    <field name="mobile" widget="phone"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                                <group string="Address Details">
                                    <field name="address" placeholder="Street Address..."/>
                                    <field name="city"/>
                                    <field name="state"/>
                                    <field name="zip"/>
                                    <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Availability" name="availability">
                            <group>
                                <group string="Timing">
                                    <field name="consultation_days"/>
                                    <field name="consultation_time"/>
                                </group>
                                <group string="Location">
                                    <field name="room_number"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes" name="internal_notes">
                            <field name="notes" placeholder="Add custom notes here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Doctor Search View -->
    <record id="view_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hospital.doctor.search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Search Doctors">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('doctor_id', 'ilike', self), ('specialization', 'ilike', self)]"/>
                <field name="doctor_id"/>
                <field name="department_id"/>
                <field name="specialization"/>
                <separator/>
                <filter string="Available" name="available_doctors" domain="[('status', '=', 'available')]"/>
                <filter string="On Leave" name="on_leave_doctors" domain="[('status', '=', 'on_leave')]"/>
                <filter string="Inactive" name="inactive_doctors" domain="[('status', '=', 'inactive')]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Doctors -->
    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_doctor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first doctor!
            </p>
            <p>
                Manage doctor profiles, qualifications, specializations, departments, and consultation availability schedules.
            </p>
        </field>
    </record>

    <!-- Menu Item for Doctors -->
    <menuitem id="menu_hospital_doctor"
              name="Doctors"
              parent="menu_hospital_configuration"
              action="action_hospital_doctor"
              sequence="20"/>
</odoo>
