<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pharmacy Request List View -->
    <record id="view_hospital_pharmacy_request_list" model="ir.ui.view">
        <field name="name">hospital.pharmacy.request.list</field>
        <field name="model">hospital.pharmacy.request</field>
        <field name="arch" type="xml">
            <list string="Pharmacy Requests" decoration-info="status == 'draft'" decoration-warning="status == 'to_pay'" decoration-primary="status == 'paid'" decoration-success="status == 'dispensed'" decoration-muted="status == 'cancelled'" create="false" edit="false">
                <field name="name"/>
                <field name="op_id"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="billing_id"/>
                <field name="request_datetime"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'to_pay'" decoration-primary="status == 'paid'" decoration-success="status == 'dispensed'" decoration-danger="status == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Pharmacy Request Form View -->
    <record id="view_hospital_pharmacy_request_form" model="ir.ui.view">
        <field name="name">hospital.pharmacy.request.form</field>
        <field name="model">hospital.pharmacy.request</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Dispensing Request" create="false">
                <header>
                    <button name="action_send_to_billing" type="object" string="Send to Billing" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_dispense" type="object" string="Dispense Medicines" class="oe_highlight" invisible="status != 'paid'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,to_pay,paid,dispensed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Dispensed" bg_color="text-bg-success" invisible="status != 'dispensed'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Patient &amp; Doctor Information">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group string="Request Details">
                            <field name="op_id"/>
                            <field name="billing_id"/>
                            <field name="request_datetime"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescribed Medicines" name="medicines_tab">
                            <field name="line_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="qty"/>
                                    <field name="is_stock_available" column_invisible="1"/>
                                    <field name="stock_availability_info" readonly="1" decoration-success="is_stock_available" decoration-danger="not is_stock_available"/>
                                    <field name="dosage" readonly="1"/>
                                    <field name="duration" readonly="1"/>
                                    <field name="instructions" readonly="1"/>
                                    <field name="pharmacist_instructions"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pharmacy Request Search View -->
    <record id="view_hospital_pharmacy_request_search" model="ir.ui.view">
        <field name="name">hospital.pharmacy.request.search</field>
        <field name="model">hospital.pharmacy.request</field>
        <field name="arch" type="xml">
            <search string="Search Pharmacy Requests">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('op_id.op_number', 'ilike', self), ('patient_id', 'ilike', self)]"/>
                <field name="op_id"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="billing_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Dispensed" name="dispensed" domain="[('status', '=', 'dispensed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_by_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor" name="group_by_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'request_datetime'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pharmacy Request Action -->
    <record id="action_hospital_pharmacy_request" model="ir.actions.act_window">
        <field name="name">Pharmacy Requests</field>
        <field name="res_model">hospital.pharmacy.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_pharmacy_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pharmacy dispensing requests found!
            </p>
            <p>
                Requests will appear here automatically when billing is completed (paid) for patient prescribed medicines.
            </p>
        </field>
    </record>

    <!-- Pharmacy Parent Menu -->
    <menuitem id="menu_hospital_pharmacy_parent"
              name="Pharmacy"
              parent="menu_hospital_root"
              sequence="28"/>

    <!-- Pharmacy Sub-menus -->
    <menuitem id="menu_hospital_pharmacy_request"
              name="Pharmacy Requests"
              parent="menu_hospital_pharmacy_parent"
              action="action_hospital_pharmacy_request"
              sequence="10"/>



    <menuitem id="menu_hospital_patient_medicine_return"
              name="Patient Returns"
              parent="menu_hospital_pharmacy_parent"
              action="action_hospital_patient_medicine_return"
              sequence="20"/>

    <!-- Stock Operations Sub-menu -->
    <menuitem id="menu_hospital_stock_operations_parent"
              name="Stock Operations"
              parent="menu_hospital_pharmacy_parent"
              sequence="25"/>

    <menuitem id="menu_hospital_medicine_purchase"
              name="Purchase Orders"
              parent="menu_hospital_stock_operations_parent"
              action="action_hospital_medicine_purchase"
              sequence="10"/>

    <menuitem id="menu_hospital_medicine_purchase_return"
              name="Purchase Returns"
              parent="menu_hospital_stock_operations_parent"
              action="action_hospital_medicine_purchase_return"
              sequence="15"/>

    <menuitem id="menu_hospital_stock_adjustment"
              name="Stock Adjustments"
              parent="menu_hospital_stock_operations_parent"
              action="action_hospital_stock_adjustment"
              sequence="20"/>

    <menuitem id="menu_hospital_expired_disposal"
              name="Disposals"
              parent="menu_hospital_stock_operations_parent"
              action="action_hospital_expired_disposal"
              sequence="25"/>

    <menuitem id="menu_hospital_stock_movement"
              name="Stock Movements"
              parent="menu_hospital_stock_operations_parent"
              action="action_hospital_stock_movement"
              sequence="30"/>

    <!-- Configuration Sub-menu -->
    <menuitem id="menu_hospital_pharmacy_config_parent"
              name="Configuration"
              parent="menu_hospital_pharmacy_parent"
              sequence="30"/>

    <menuitem id="menu_hospital_medicine"
              name="Medicines"
              parent="menu_hospital_pharmacy_config_parent"
              action="action_hospital_medicine"
              sequence="10"/>

    <menuitem id="menu_hospital_medicine_category"
              name="Medicine Categories"
              parent="menu_hospital_pharmacy_config_parent"
              action="action_hospital_medicine_category"
              sequence="15"/>

    <menuitem id="menu_hospital_medicine_batch"
              name="Batches"
              parent="menu_hospital_pharmacy_config_parent"
              action="action_hospital_medicine_batch"
              sequence="20"/>

    <menuitem id="menu_hospital_medicine_supplier"
              name="Suppliers"
              parent="menu_hospital_pharmacy_config_parent"
              action="action_hospital_medicine_supplier"
              sequence="25"/>

    <menuitem id="menu_hospital_pharmacy_alert"
              name="Inventory Alerts"
              parent="menu_hospital_pharmacy_config_parent"
              action="action_hospital_pharmacy_alert"
              sequence="30"/>
</odoo>
