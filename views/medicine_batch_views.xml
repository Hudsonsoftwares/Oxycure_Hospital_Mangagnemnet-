<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Batch List View -->
    <record id="view_hospital_medicine_batch_list" model="ir.ui.view">
        <field name="name">hospital.medicine.batch.list</field>
        <field name="model">hospital.medicine.batch</field>
        <field name="arch" type="xml">
            <list string="Medicine Batches" decoration-danger="qty_remaining == 0">
                <field name="name"/>
                <field name="medicine_id"/>
                <field name="expiry_date"/>
                <field name="qty_original"/>
                <field name="qty_remaining"/>
                <field name="purchase_price"/>
                <field name="selling_price"/>
            </list>
        </field>
    </record>

    <!-- Batch Form View -->
    <record id="view_hospital_medicine_batch_form" model="ir.ui.view">
        <field name="name">hospital.medicine.batch.form</field>
        <field name="model">hospital.medicine.batch</field>
        <field name="arch" type="xml">
            <form string="Medicine Batch">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Batch Number (e.g. BATCH-001)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Medicine &amp; Stock">
                            <field name="medicine_id"/>
                            <field name="qty_original" readonly="1"/>
                            <field name="qty_remaining"/>
                        </group>
                        <group string="Dates &amp; Pricing">
                            <field name="manufacturing_date"/>
                            <field name="expiry_date"/>
                            <field name="purchase_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Batch Search View -->
    <record id="view_hospital_medicine_batch_search" model="ir.ui.view">
        <field name="name">hospital.medicine.batch.search</field>
        <field name="model">hospital.medicine.batch</field>
        <field name="arch" type="xml">
            <search string="Search Medicine Batches">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('medicine_id.name', 'ilike', self)]"/>
                <field name="medicine_id"/>
                <filter string="In Stock" name="in_stock" domain="[('qty_remaining', '>', 0)]"/>
                <filter string="Expired" name="expired" domain="[('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Medicine" name="group_by_medicine" context="{'group_by': 'medicine_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Batch Action -->
    <record id="action_hospital_medicine_batch" model="ir.actions.act_window">
        <field name="name">Medicine Batches</field>
        <field name="res_model">hospital.medicine.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_medicine_batch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No medicine batches found!
            </p>
            <p>
                Batches are created automatically when receiving purchase orders, or they can be adjusted here.
            </p>
        </field>
    </record>
</odoo>
