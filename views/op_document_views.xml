<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OP Document Views -->
    <record id="view_hospital_op_document_tree" model="ir.ui.view">
        <field name="name">hospital.op.document.tree</field>
        <field name="model">hospital.op.document</field>
        <field name="arch" type="xml">
            <list string="OP Documents">
                <field name="name"/>
                <field name="document_type" widget="badge" decoration-info="document_type == 'medical_certificate'" decoration-warning="document_type == 'referral_letter'" decoration-success="document_type == 'fitness_certificate'"/>
                <field name="date_generated"/>
                <button name="action_print_pdf" string="Print PDF" type="object" icon="fa-print" class="btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_op_document_form" model="ir.ui.view">
        <field name="name">hospital.op.document.form</field>
        <field name="model">hospital.op.document</field>
        <field name="arch" type="xml">
            <form string="OP Document">
                <header>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="oe_highlight" icon="fa-print"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="document_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="op_id" readonly="1" options="{'no_open': True}"/>
                            <field name="date_generated" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Document Editor">
                            <field name="content" widget="html" options="{'style-inline': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Medical Certificate Wizard View -->
    <record id="view_hospital_medical_certificate_wizard_form" model="ir.ui.view">
        <field name="name">hospital.medical.certificate.wizard.form</field>
        <field name="model">hospital.medical.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Medical Leave Certificate">
                <sheet>
                    <group string="Basic Information">
                        <group>
                            <field name="diagnosis" placeholder="e.g. Acute Gastroenteritis"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="rest_days"/>
                            <field name="follow_up_date"/>
                            <field name="op_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Clinical Details &amp; Findings">
                        <field name="clinical_findings" placeholder="e.g. Dehydration, abdominal tenderness, fever..." style="min-height: 80px;"/>
                        <field name="advice" placeholder="e.g. Rest, oral rehydration therapy, soft diet..." style="min-height: 80px;"/>
                    </group>
                    <group string="Additional Remarks">
                        <field name="additional_notes" placeholder="Enter optional additional remarks..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generate Certificate" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Referral Letter Wizard View -->
    <record id="view_hospital_referral_letter_wizard_form" model="ir.ui.view">
        <field name="name">hospital.referral.letter.wizard.form</field>
        <field name="model">hospital.referral.letter.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Referral Letter">
                <sheet>
                    <group string="Referral Destination">
                        <group>
                            <field name="refer_to"/>
                            <field name="referred_hospital"/>
                        </group>
                        <group>
                            <field name="referred_department"/>
                            <field name="reason"/>
                            <field name="op_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Clinical Information">
                        <field name="clinical_summary" placeholder="e.g. Patient presented with..." style="min-height: 80px;"/>
                        <field name="investigation_findings" placeholder="e.g. ECG shows..." style="min-height: 80px;"/>
                    </group>
                    <group string="Treatment &amp; Instructions">
                        <field name="current_medications" placeholder="e.g. Tab Paracetamol 650mg..." style="min-height: 80px;"/>
                        <field name="special_instructions" placeholder="e.g. Please evaluate for emergency angiogram..." style="min-height: 80px;"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generate Referral Letter" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Fitness Certificate Wizard View -->
    <record id="view_hospital_fitness_certificate_wizard_form" model="ir.ui.view">
        <field name="name">hospital.fitness.certificate.wizard.form</field>
        <field name="model">hospital.fitness.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Medical Fitness Certificate">
                <sheet>
                    <group string="Fitness Details">
                        <group>
                            <field name="diagnosis" placeholder="e.g. Post-appendectomy status"/>
                            <field name="fitness_status"/>
                        </group>
                        <group>
                            <field name="fit_from_date"/>
                            <field name="op_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Accommodations or Restrictions">
                        <field name="restrictions" placeholder="e.g. Avoid heavy lifting for 2 weeks..." style="min-height: 80px;"/>
                    </group>
                    <group string="Additional Remarks">
                        <field name="additional_notes" placeholder="Enter optional physical recovery remarks..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generate Fitness Certificate" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- QWeb PDF Report Definition -->
    <record id="action_report_op_document" model="ir.actions.report">
        <field name="name">OP Visit Document</field>
        <field name="model">hospital.op.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_op_document_template</field>
        <field name="report_file">hospital_management.report_op_document_template</field>
        <field name="binding_model_id" ref="model_hospital_op_document"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_op_document_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; padding: 20px;">
                        <!-- Clinic Letterhead Header -->
                        <div style="border-bottom: 3px double #004d40; padding-bottom: 10px; margin-bottom: 30px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 20%; vertical-align: middle;" t-if="o.env.company.logo">
                                        <img t-att-src="image_data_uri(o.env.company.logo)" style="max-height: 70px; max-width: 100%;" alt="Logo"/>
                                    </td>
                                    <td style="width: 50%; vertical-align: middle; padding-left: 15px;">
                                        <h2 style="color: #004d40; margin: 0; font-weight: bold; font-size: 24px;"><span t-field="o.env.company.name"/></h2>
                                        <p style="margin: 3px 0; font-size: 12px; color: #555;">
                                            <t t-if="o.env.company.street"><span t-field="o.env.company.street"/>, </t>
                                            <t t-if="o.env.company.street2"><span t-field="o.env.company.street2"/>, </t>
                                            <t t-if="o.env.company.city"><span t-field="o.env.company.city"/></t>
                                            <t t-if="o.env.company.state_id">, <span t-field="o.env.company.state_id.name"/></t>
                                            <t t-if="o.env.company.zip"> - <span t-field="o.env.company.zip"/></t>
                                        </p>
                                        <p style="margin: 3px 0; font-size: 12px; color: #555;">
                                            <t t-if="o.env.company.phone">Phone: <span t-field="o.env.company.phone"/></t>
                                            <t t-if="o.env.company.email"> | Email: <span t-field="o.env.company.email"/></t>
                                        </p>
                                        <p style="margin: 3px 0; font-size: 11px; color: #777;" t-if="o.env.company.company_registry">
                                            Reg No: <span t-field="o.env.company.company_registry"/>
                                        </p>
                                    </td>
                                    <td style="width: 30%; text-align: right; vertical-align: middle;">
                                        <span style="font-weight: bold; font-size: 13px; text-transform: uppercase; color: #004d40; border: 1.5px solid #004d40; padding: 6px 12px; border-radius: 4px; display: inline-block;">
                                            <t t-if="o.document_type == 'medical_certificate'">Medical Certificate</t>
                                            <t t-if="o.document_type == 'referral_letter'">Referral Letter</t>
                                            <t t-if="o.document_type == 'fitness_certificate'">Fitness Certificate</t>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Patient Info Grid -->
                        <div style="background-color: #f8fafc; padding: 15px; border-radius: 6px; border: 1px solid #e2e8f0; margin-bottom: 25px;">
                            <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 15%; font-weight: bold; color: #475569; padding: 4px 0;">Patient Name:</td>
                                    <td style="width: 45%; color: #0f172a; padding: 4px 0;"><span t-field="o.patient_id.name"/></td>
                                    <td style="width: 15%; font-weight: bold; color: #475569; padding: 4px 0;">Document Date:</td>
                                    <td style="width: 25%; color: #0f172a; padding: 4px 0;"><span t-field="o.date_generated" t-options='{"widget": "date"}'/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #475569; padding: 4px 0;">Patient ID (UHID):</td>
                                    <td style="color: #0f172a; padding: 4px 0;"><span t-field="o.patient_id.patient_id"/></td>
                                    <td style="font-weight: bold; color: #475569; padding: 4px 0;">OP Visit Ref:</td>
                                    <td style="color: #0f172a; padding: 4px 0;"><span t-field="o.op_id.op_number"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; color: #475569; padding: 4px 0;">Age / Gender:</td>
                                    <td style="color: #0f172a; padding: 4px 0;"><span t-field="o.patient_id.age"/> Yrs / <span t-field="o.patient_id.gender" style="text-transform: capitalize;"/></td>
                                    <td style="font-weight: bold; color: #475569; padding: 4px 0;">Phone:</td>
                                    <td style="color: #0f172a; padding: 4px 0;"><span t-out="o.patient_id.mobile or o.patient_id.phone or 'N/A'"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- Document Body Content -->
                        <div style="font-size: 15px; line-height: 1.8; color: #222; min-height: 350px; padding: 10px 0;">
                            <t t-out="o.content"/>
                        </div>

                        <!-- Footer Signatures -->
                        <div style="margin-top: 50px; border-top: 1px solid #ddd; padding-top: 20px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 60%; vertical-align: bottom;">
                                        <p style="font-size: 11px; color: #777; margin: 0;">This document is generated by <span t-field="o.env.company.name"/> and holds official status under medical regulations.</p>
                                    </td>
                                    <td style="width: 40%; text-align: right; vertical-align: bottom;">
                                        <div style="display: inline-block; text-align: left; font-size: 12px; line-height: 1.5; color: #333; min-width: 220px;">
                                            <!-- Doctor Signature Image if available -->
                                            <div style="height: 45px; text-align: left; vertical-align: bottom; margin-bottom: 5px;" t-if="o.op_id.doctor_id.signature">
                                                 <img t-att-src="image_data_uri(o.op_id.doctor_id.signature)" style="max-height: 40px; display: block; margin-left: 0; margin-right: auto;" alt="Signature"/>
                                            </div>
                                            <div style="height: 45px;" t-else=""></div>
                                            <p style="margin: 0; font-weight: bold; border-top: 1px solid #333; padding-top: 5px;">Dr. <span t-field="o.op_id.doctor_id.name"/></p>
                                            <p style="margin: 0; color: #555; font-size: 11px;">
                                                <span t-field="o.op_id.doctor_id.qualification"/>
                                                <t t-if="o.op_id.doctor_id.specialization"> - <span t-field="o.op_id.doctor_id.specialization"/></t>
                                            </p>
                                            <p style="margin: 0; color: #555; font-size: 11px;" t-if="o.op_id.doctor_id.department_id">Dept: <span t-field="o.op_id.doctor_id.department_id.name"/></p>
                                            <p style="margin: 0; color: #555; font-size: 11px;" t-if="o.op_id.doctor_id.medical_registration_no">Reg No: <span t-field="o.op_id.doctor_id.medical_registration_no"/></p>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
