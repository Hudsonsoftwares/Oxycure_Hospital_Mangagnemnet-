<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medicine List View -->
    <record id="view_hospital_medicine_list" model="ir.ui.view">
        <field name="name">hospital.medicine.list</field>
        <field name="model">hospital.medicine</field>
        <field name="arch" type="xml">
            <list string="Medicines" decoration-success="status == 'active'" decoration-muted="status == 'inactive'">
                <field name="name"/>
                <field name="code"/>
                <field name="brand_name"/>
                <field name="generic_name"/>
                <field name="category_id"/>
                <field name="price" string="Selling Price"/>
                <field name="qty_available"/>
                <field name="stock_status" widget="badge" decoration-success="stock_status == 'in_stock'" decoration-warning="stock_status == 'low_stock'" decoration-danger="stock_status == 'out_of_stock'"/>
                <field name="expiry_date"/>
                <field name="requires_prescription" widget="boolean_toggle"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'inactive'"/>
            </list>
        </field>
    </record>

    <!-- Medicine Form View -->
    <record id="view_hospital_medicine_form" model="ir.ui.view">
        <field name="name">hospital.medicine.form</field>
        <field name="model">hospital.medicine</field>
        <field name="arch" type="xml">
            <form string="Medicine Info">
                <header>
                    <button name="action_ai_auto_restock" type="object" string="AI Auto-Restock" class="btn-primary" icon="fa-magic" invisible="stock_status == 'in_stock'"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Medicine Name (e.g. Paracetamol 650mg)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="code" placeholder="e.g. MED001"/>
                            <field name="brand_name" placeholder="Brand Name"/>
                            <field name="generic_name" placeholder="Generic Name"/>
                            <field name="category_id"/>
                            <field name="manufacturer" placeholder="Manufacturer"/>
                        </group>
                        <group string="Form &amp; Strength">
                            <field name="dosage_form"/>
                            <field name="strength"/>
                            <field name="unit"/>
                            <field name="requires_prescription" widget="boolean_toggle"/>
                            <field name="status"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tax &amp; Identification">
                            <field name="barcode" placeholder="Barcode"/>
                            <field name="hsn_code" placeholder="HSN Code"/>
                            <field name="gst_rate"/>
                        </group>
                        <group string="Pricing &amp; Storage">
                            <field name="price" string="Selling Price"/>
                            <field name="purchase_price"/>
                            <field name="storage_condition" placeholder="e.g. Store below 25°C"/>
                        </group>
                    </group>
                    <group>
                        <group string="Inventory Thresholds">
                            <field name="minimum_stock"/>
                            <field name="reorder_level"/>
                        </group>
                        <group string="Current Stock (Computed)">
                            <field name="qty_available" readonly="1"/>
                            <field name="stock_status" widget="badge" decoration-success="stock_status == 'in_stock'" decoration-warning="stock_status == 'low_stock'" decoration-danger="stock_status == 'out_of_stock'"/>
                            <field name="expiry_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Approved Suppliers">
                        <field name="supplier_ids" widget="many2many_tags" placeholder="Select approved suppliers for this medicine..." options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="Alternative Medicines (Substitutes)">
                        <field name="alternative_ids" widget="many2many_tags" placeholder="Select alternative/substitute medicines..." options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <notebook>
                        <page string="Active Batches" name="batches">
                            <field name="batch_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="manufacturing_date"/>
                                    <field name="expiry_date"/>
                                    <field name="qty_original"/>
                                    <field name="qty_remaining"/>
                                    <field name="purchase_price"/>
                                    <field name="selling_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description_tab">
                            <field name="description" placeholder="Enter medicine description/notes here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Medicine Search View -->
    <record id="view_hospital_medicine_search" model="ir.ui.view">
        <field name="name">hospital.medicine.search</field>
        <field name="model">hospital.medicine</field>
        <field name="arch" type="xml">
            <search string="Search Medicines">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('generic_name', 'ilike', self)]"/>
                <field name="code"/>
                <field name="generic_name"/>
                <field name="brand_name"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Active Status" name="active_status" domain="[('status', '=', 'active')]"/>
                <filter string="Inactive Status" name="inactive_status" domain="[('status', '=', 'inactive')]"/>
                <filter string="Requires Prescription" name="req_prescription" domain="[('requires_prescription', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Dosage Form" name="group_by_dosage_form" context="{'group_by': 'dosage_form'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Medicine Action -->
    <record id="action_hospital_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">hospital.medicine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_medicine_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first medicine!
            </p>
            <p>
                Create a master list of medicines that can be prescribed by doctors during consultations.
            </p>
        </field>
    </record>
</odoo>
